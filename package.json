{
  "name": "am20",
  "version": "1.0.0",
  "description": "Build system for am20 Website",
  "main": "script.js",
 "scripts": {
  "build:css": "cross-env NODE_ENV=production postcss style.css -o dist/style.min.css",
  "build:js": "npx terser script.js -o dist/script.min.js --compress --mangle",
  "build": "npm run build:css && npm run build:js"
},
  "keywords": [
    "tailwind",
    "am20",
    "postcss",
    "terser"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.36.0",
    "adm-zip": "^0.5.10",
    "axios": "^1.6.0",
    "stripe": "^20.4.1"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.19",
    "cross-env": "^7.0.3",
    "cssnano": "^7.0.3",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.4.38",
    "postcss-cli": "^11.0.1",
    "tailwindcss": "^3.4.4",
    "terser": "^5.31.1"
  }
}
